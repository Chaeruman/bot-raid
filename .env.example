# Copy this to .env and fill in. .env is gitignored — never commit it.
#
# --- Usually SAME between production and local/staging ---
TOKEN=
CLIENT_ID=
MONGODB_URI=

# --- MUST differ for local/staging (points at test data instead of prod) ---
MONGODB_DB_NAME=bot-raid-staging
GUILD_ID=

# --- Guild-specific IDs — only matter for whatever server GUILD_ID points to,
#     so re-fill these with IDs from your test server ---
THREAD_CHANNEL_ID=
FORUM_TAG_HC=
FORUM_TAG_CL=
FORUM_TAG_DDN=
FORUM_TAG_DDN_HC=
FORUM_TAG_SDN_HC=
FORUM_TAG_SDN_CORE=
FORUM_TAG_MARATHON_GDN=
FORUM_TAG_MARATHON_DDN=
COLEADER_ROLE_ID=
TIM1_ROLE_ID=
TIM2_ROLE_ID=
DIGEST_CHANNEL_ID=
TOP5_CHANNEL_ID=
DIGEST_ENABLED=false

# --- Not needed locally (Render-only) ---
RENDER_URL=
PORT=3000
DISCORD_PROXY_URL=
